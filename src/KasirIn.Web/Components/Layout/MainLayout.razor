@inherits LayoutComponentBase
@inject KasirInUserSession UserSession
@implements IDisposable

<div class="min-h-screen bg-surface flex flex-col md:flex-row text-on-surface">
    <!-- Sidebar Navigation -->
    <NavMenu />

    <!-- Main Container -->
    <div class="flex-1 flex flex-col md:ml-[280px] w-full min-h-screen bg-surface">
        <!-- Top App Header -->
        <header class="flex justify-between items-center w-full h-16 px-6 bg-surface border-b border-outline-variant shadow-sm sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <button class="md:hidden text-on-surface-variant p-2 rounded-lg hover:bg-surface-container-high" @onclick="ToggleMobileMenu">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl font-extrabold text-primary tracking-tight">KasirIn</h1>
                    <span class="bg-primary-container text-on-primary-container text-xs px-2 py-0.5 rounded-full font-bold">Cloud POS</span>
                </div>
            </div>

            <!-- Top Right Actions & RBAC Persona Switcher -->
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 bg-surface-container border border-outline-variant rounded-full p-1 text-xs shadow-inner">
                    <button type="button" class="px-3 py-1 rounded-full font-extrabold transition-all duration-200 cursor-pointer @(UserSession.IsOwner ? "bg-primary text-white shadow-sm" : "text-on-surface-variant hover:text-on-surface")"
                            @onclick='() => SwitchPersona("OWNER")'>
                        Pemilik (Owner)
                    </button>
                    <button type="button" class="px-3 py-1 rounded-full font-extrabold transition-all duration-200 cursor-pointer @(UserSession.IsCashier ? "bg-primary text-white shadow-sm" : "text-on-surface-variant hover:text-on-surface")"
                            @onclick='() => SwitchPersona("CASHIER")'>
                        Kasir
                    </button>
                </div>

                <div class="h-6 w-px bg-outline-variant mx-1 hidden sm:block"></div>

                <div class="flex items-center gap-2 p-1.5 px-3 bg-surface-container-lowest rounded-full border border-outline-variant shadow-sm">
                    <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-extrabold text-xs shadow-xs">
                        @(UserSession.IsOwner ? "OW" : "KS")
                    </div>
                    <span class="text-xs font-extrabold text-on-surface hidden sm:inline">
                        @(UserSession.IsOwner ? "Pemilik Toko" : "Kasir Operasional")
                    </span>
                </div>
            </div>
        </header>

        <!-- Mobile Drawer Overlay -->
        @if (_isMobileMenuOpen)
        {
            <div class="fixed inset-0 bg-on-surface/40 z-50 md:hidden" @onclick="ToggleMobileMenu">
                <div class="w-64 h-full bg-surface p-4 flex flex-col gap-4 shadow-xl" @onclick:stopPropagation="true">
                    <div class="flex justify-between items-center pb-2 border-b border-outline-variant">
                        <span class="font-bold text-primary">Navigasi KasirIn</span>
                        <button class="text-on-surface-variant" @onclick="ToggleMobileMenu">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <ul class="flex flex-col gap-2">
                        <li>
                            <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-3 p-3 rounded-lg text-sm font-medium hover:bg-surface-container-high" @onclick="ToggleMobileMenu">
                                <span class="material-symbols-outlined">dashboard</span> Analytics Dashboard
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="pos" class="flex items-center gap-3 p-3 rounded-lg text-sm font-medium hover:bg-surface-container-high" @onclick="ToggleMobileMenu">
                                <span class="material-symbols-outlined">point_of_sale</span> POS Kasir
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="inventory" class="flex items-center gap-3 p-3 rounded-lg text-sm font-medium hover:bg-surface-container-high" @onclick="ToggleMobileMenu">
                                <span class="material-symbols-outlined">inventory_2</span> Manajemen Stok
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="reports" class="flex items-center gap-3 p-3 rounded-lg text-sm font-medium hover:bg-surface-container-high" @onclick="ToggleMobileMenu">
                                <span class="material-symbols-outlined">assessment</span> Laporan Keuangan
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        }

        <!-- Main Body Canvas -->
        <main class="flex-1 p-4 md:p-6 bg-surface overflow-x-hidden">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _isMobileMenuOpen = false;

    protected override void OnInitialized()
    {
        UserSession.OnRoleChanged += StateHasChanged;
    }

    private void SwitchPersona(string role)
    {
        UserSession.SwitchRole(role);
    }

    private void ToggleMobileMenu()
    {
        _isMobileMenuOpen = !_isMobileMenuOpen;
    }

    public void Dispose()
    {
        UserSession.OnRoleChanged -= StateHasChanged;
    }
}
